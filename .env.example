# ─────────────────────────────────────────────────────────────
# جيل العمل / Jeel Alamal — environment variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────

# ===== Database (PostgreSQL) =====
POSTGRES_USER=jeel
POSTGRES_PASSWORD=change_me_in_local
POSTGRES_DB=jeel_alamal
POSTGRES_PORT=5432
# Host used by the backend container to reach the db service (compose service name)
DATABASE_HOST=db
DATABASE_PORT=5432

# ===== Backend (NestJS) =====
BACKEND_PORT=3001
NODE_ENV=development
# JWT auth — access and refresh use SEPARATE secrets (both min 16 chars)
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_to_a_different_long_random_string
JWT_REFRESH_EXPIRES_IN=7d
# Seeded once on first boot — the single super admin account
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=change_me_min_8_chars

# ===== Frontend (Next.js) =====
FRONTEND_PORT=3000
# Public URL the browser uses to call the backend (host port, not service name)
NEXT_PUBLIC_API_URL=http://localhost:3001
